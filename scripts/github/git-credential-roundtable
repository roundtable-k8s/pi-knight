#!/bin/sh
# git-credential-roundtable: git credential helper for Round Table knights.
#
# The operator mounts a GitHub token Secret at $GITHUB_TOKEN_FILE (see
# roundtable-k8s/roundtable#194). The kubelet rewrites that file when the
# Secret rotates, so this helper re-reads it on every `get` and short-lived
# GitHub App installation tokens keep working in long-running pods.
#
# It answers only `get` for https://github.com. It prints nothing (git then
# falls through to its next helper) when the file is unset, unreadable or
# empty. `store` and `erase` are no-ops. It never logs the token.
set -u

protocol=""
host=""
# Consume the whole request so git never sees a broken pipe.
while IFS= read -r line || [ -n "$line" ]; do
  [ -z "$line" ] && break
  case $line in
    protocol=*) protocol=${line#protocol=} ;;
    host=*) host=${line#host=} ;;
  esac
done

[ "${1:-}" = "get" ] || exit 0
[ "$protocol" = "https" ] || exit 0
[ "$host" = "github.com" ] || exit 0

file=${GITHUB_TOKEN_FILE:-}
[ -n "$file" ] && [ -r "$file" ] || exit 0
token=$(tr -d '\r\n' < "$file" 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0

printf 'username=x-access-token\npassword=%s\n' "$token"
